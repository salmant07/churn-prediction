   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"../data/BankChurners.csv\")\n",
    "df = df.drop(columns=[\"CLIENTNUM\"] + [c for c in df.columns if c.startswith(\"Naive_Bayes\")])\n",
    "df[\"churn\"] = (df[\"Attrition_Flag\"] == \"Attrited Customer\").astype(int)\n",
    "\n",
    "print(df.shape)\n",
    "print(df[\"churn\"].mean())\n",
    "df.head()\n"
   ]
